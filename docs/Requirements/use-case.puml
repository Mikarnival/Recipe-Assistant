@startuml use-case

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Home Cook" as User

rectangle "Recipe Assistant" {

    package "EP-01 Recipe Library" {
        usecase "Browse Recipes" as UC_LIB_01
        usecase "Search Recipes" as UC_LIB_02
        usecase "View Recipe Details" as UC_LIB_03
        usecase "Manage Favorites" as UC_LIB_04
        usecase "Filter Recipes by Category" as UC_LIB_05
        usecase "Sort Recipes" as UC_LIB_06
    }

    package "EP-02 Recipe Import" {
        usecase "Create Recipe Manually" as UC_IMP_01
        usecase "Edit Recipe" as UC_IMP_02
        usecase "Delete Recipe" as UC_IMP_03
    }

    package "EP-03 Cooking Experience" {
        usecase "Start Cooking Mode" as UC_COOK_01
        usecase "View One Cooking Step\nat a Time" as UC_COOK_02
        usecase "Navigate Between\nCooking Steps" as UC_COOK_03
        usecase "View Ingredient Quantities" as UC_COOK_04
        usecase "Mark Cooking Steps\nas Completed" as UC_COOK_05
        usecase "View Preparation Tasks" as UC_COOK_06
    }

    package "EP-04 Personalization" {
        usecase "Manage Spoon Profiles" as UC_PER_01
        usecase "Set Taste Preference" as UC_PER_02
        usecase "Choose Measurement Unit" as UC_PER_03
        usecase "Set Default Serving Size" as UC_PER_04
        usecase "Save Personal Preferences" as UC_PER_05
    }
}

User --> UC_LIB_01
User --> UC_LIB_02
User --> UC_LIB_03
User --> UC_LIB_04
User --> UC_LIB_05
User --> UC_LIB_06

User --> UC_IMP_01
User --> UC_IMP_02
User --> UC_IMP_03

User --> UC_COOK_01
User --> UC_COOK_06

UC_COOK_01 ..> UC_COOK_02 : <<include>>
UC_COOK_01 ..> UC_COOK_03 : <<include>>
UC_COOK_01 ..> UC_COOK_04 : <<include>>

UC_COOK_05 ..> UC_COOK_02 : <<extend>>

User --> UC_PER_01
User --> UC_PER_02
User --> UC_PER_03
User --> UC_PER_04

UC_PER_01 ..> UC_PER_05 : <<include>>
UC_PER_02 ..> UC_PER_05 : <<include>>
UC_PER_03 ..> UC_PER_05 : <<include>>
UC_PER_04 ..> UC_PER_05 : <<include>>

@enduml