.page {
  min-height: 100vh;
  padding: 32rpx;
  background-color: #f5f5f5;
}

.recipe-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.recipe-header-info {
  flex: 1;
}

.recipe-title {
  margin-bottom: 16rpx;
  font-size: 40rpx;
  font-weight: bold;
}

.recipe-meta {
  font-size: 28rpx;
  line-height: 1.5;
  color: #666666;
}

.edit-button {
  padding: 12rpx 22rpx;
  background-color: #333333;
  border-radius: 24rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.section {
  margin-top: 32rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.ingredient-item {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 8rpx;

  font-size: 28rpx;
  line-height: 1.6;
}

.ingredient-name {
  color: #222222;
}

.ingredient-amount {
  color: #666666;
}

.preparation-item {
  margin-bottom: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-message {
  font-size: 26rpx;
  color: #888888;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 35rpx;
  height: 35rpx;

  flex-shrink: 0;

  border-radius: 50%;
  background-color: #333333;
  color: #ffffff;

  font-size: 24rpx;
  font-weight: bold;
}

.step-instruction {
  margin-left: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #222222;
}

.status-message {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}

.error-message {
  color: #d93025;
}