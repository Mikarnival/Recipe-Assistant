.page {
  padding: 32rpx;
}

.recipe-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.recipe-meta {
  font-size: 28rpx;
  line-height: 1.5;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 32rpx;
  margin-bottom: 12rpx;
}

.ingredient-item,
.preparation-item,
.step-item {
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  align-items: center;

  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.ingredient-name {
  color: #222;
}

.ingredient-amount {
  color: #666;
}

.section {
  margin-top: 32rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  background-color: #f5f5f5;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-number {
  width: 35rpx;
  height: 35rpx;
  border-radius: 50%;

  background-color: #333333;
  color: #ffffff;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 24rpx;
  font-weight: bold;

  flex-shrink: 0;
}

.step-instruction {
  margin-left: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #222222;
}

.status-message {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
}

.error-message {
  color: #d93025;
}