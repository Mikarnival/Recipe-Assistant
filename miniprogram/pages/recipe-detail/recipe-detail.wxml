<view class="page">

  <!-- Loading state -->
  <view class="status-message" wx:if="{{loading}}">
    Loading...
  </view>

  <!-- Error state -->
  <view class="status-message error-message" wx:elif="{{error}}">
    {{error}}
  </view>

  <!-- Recipe detail -->
  <view wx:elif="{{recipe}}">

    <!-- Header -->
    <view class="recipe-header">

      <view class="recipe-header-info">

        <view class="recipe-title">
          {{recipe.title}}
        </view>

        <view class="recipe-meta">
          {{recipe.category}}
        </view>

        <view class="recipe-meta">
          Servings: {{recipe.servings}}
        </view>

      </view>

      <view class="recipe-actions">

        <view class="edit-button" bindtap="onEditRecipeTap">
          Edit
        </view>

        <view class="delete-button {{deleting ? 'disabled' : ''}}" bindtap="onDeleteRecipeTap">
          {{deleting ? 'Deleting...' : 'Delete'}}
        </view>

      </view>

      <view class="start-cooking-button" bindtap="onStartCookingTap">
        Start Cooking
      </view>

    </view>


    <!-- Ingredients -->
    <view class="section">

      <view class="section-title">
        Ingredients
      </view>

      <view class="ingredient-item" wx:for="{{recipe.ingredients}}" wx:key="name">

        <view class="ingredient-name">
          {{item.name}}
        </view>

        <view class="ingredient-amount">
          {{item.quantity}} {{item.unit}}
        </view>

      </view>

    </view>


    <!-- Preparation -->
    <view class="section">

      <view class="section-title">
        Preparation
      </view>

      <view wx:if="{{recipe.preparation_tasks.length === 0}}" class="empty-message">
        No preparation tasks.
      </view>

      <block wx:else>

        <view class="preparation-item" wx:for="{{recipe.preparation_tasks}}" wx:key="index">

          <view class="preparation-number">
            {{index + 1}}
          </view>

          <view class="preparation-text">
            {{item}}
          </view>

        </view>

      </block>

    </view>


    <!-- Steps -->
    <view class="section">

      <view class="section-title">
        Steps
      </view>

      <view class="step-item" wx:for="{{recipe.steps}}" wx:key="index">

        <view class="step-number">
          {{index + 1}}
        </view>

        <view class="step-instruction">
          {{item.instruction}}
        </view>

      </view>

    </view>

  </view>

</view>