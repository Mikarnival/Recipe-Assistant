.page {
  padding: 32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
}

.recipe-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.recipe-title {
  font-size: 32rpx;
  font-weight: 600;
}

.recipe-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
}

.status-message {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #666666;
}

.error {
  color: #c62828;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.search-icon {
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #666666;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.controls {
  margin-bottom: 32rpx;
}

.favorite-filter-section,
.filter-section,
.sort-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.control-option {
  padding: 12rpx 20rpx;
  background-color: #f2f2f2;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #555555;
}

.control-option.active {
  background-color: #333333;
  color: #ffffff;
}

.recipe-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.favorite-button {
  padding: 8rpx;
  font-size: 40rpx;
  line-height: 1;
}