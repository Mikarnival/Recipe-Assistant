<view class="page">
  <view class="page-title">My Recipes</view>

  <view wx:if="{{loading}}" class="status-message">
    Loading...
  </view>

  <view wx:elif="{{error}}" class="status-message error">
    {{error}}
  </view>

  <view wx:elif="{{recipes.length === 0}}" class="status-message">
    No recipes yet.
  </view>

  <view wx:else>
    <view
      class="recipe-card"
      wx:for="{{recipes}}"
      wx:key="id"
    >
      <view class="recipe-title">
        {{item.title}}
      </view>

      <view class="recipe-meta">
        {{item.category}} · {{item.servings}} servings
      </view>
    </view>
  </view>
</view>