<view class="page">
  <view class="page-title">My Recipes</view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="Search recipes"
      value="{{searchTerm}}"
      bindinput="onSearchInput"
    />
  </view>

  <view wx:if="{{loading}}" class="status-message">
    Loading...
  </view>

  <view wx:elif="{{error}}" class="status-message error">
    {{error}}
  </view>

  <view wx:elif="{{recipes.length === 0 && searchTerm}}" class="status-message">
    No recipes yet.
  </view>

  <view
    wx:elif="{{recipes.length === 0}}"
  c lass="status-message"
  >
    No recipes yet.
  </view>

  <view wx:else>
    <view
      class="recipe-card"
      wx:for="{{recipes}}"
      wx:key="id"
      bindtap="onRecipeTap"
      data-recipe-id="{{item.id}}"
    >
      <view class="recipe-title">
        {{item.title}}
      </view>

      <view class="recipe-meta">
        {{item.category}} · {{item.servings}} servings
      </view>
    </view>
  </view>
</view>

