.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background-color: #f5f5f5;
}

.page-title {
  margin-bottom: 32rpx;
  font-size: 40rpx;
  font-weight: bold;
}

.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
}

.section-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.picker-value,
.input {
  padding: 18rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.input {
  margin-top: 12rpx;
}

.spoon-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.spoon-actions {
  display: flex;
  gap: 20rpx;
}

.edit-link {
  color: #333333;
}

.delete-button {
  color: #c62828;
}

.secondary-button {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 2rpx solid #333333;
  border-radius: 12rpx;
  text-align: center;
}

.save-button {
  padding: 22rpx;
  background-color: #333333;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  color: #ffffff;
}

.save-message {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
}

